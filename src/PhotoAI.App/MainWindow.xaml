<Window x:Class="PhotoAI.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhotoAI - Local AI Photo Search" 
        Height="900" Width="1400"
        MinHeight="600" MinWidth="800"
        Background="{StaticResource PrimaryBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation -->
        <Border Grid.Column="0" Background="{StaticResource SecondaryBrush}">
            <DockPanel>
                <!-- Logo -->
                <TextBlock DockPanel.Dock="Top" 
                           Text="PhotoAI" 
                           FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"
                           Margin="16,16,16,24"/>

                <!-- Navigation -->
                <StackPanel DockPanel.Dock="Top">
                    <Button Content="Library" Style="{StaticResource NavButton}" 
                            Command="{Binding NavigateCommand}" CommandParameter="Library"/>
                    <Button Content="People" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateCommand}" CommandParameter="People"/>
                    <Button Content="Map" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateCommand}" CommandParameter="Map"/>
                    <Button Content="Search" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateCommand}" CommandParameter="Search"/>
                    <Button Content="Similar" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateCommand}" CommandParameter="Similar"/>
                    <Button Content="Duplicates" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateCommand}" CommandParameter="Duplicates"/>
                    <Button Content="Albums" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateCommand}" CommandParameter="Albums"/>
                    <Button Content="Settings" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
                </StackPanel>

                <!-- Bottom Status -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,16">
                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding StatusText}" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content -->
        <DockPanel Grid.Column="1" Margin="0">
            <!-- Top Search Bar -->
            <Border DockPanel.Dock="Top" Background="{StaticResource SecondaryBrush}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" 
                             x:Name="SearchTextBox"
                             Style="{StaticResource SearchBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="SearchBox_KeyDown"
                             VerticalContentAlignment="Center"/>

                    <Button Grid.Column="1" Content="Search" 
                            Margin="8,0,0,0" Padding="16,8"
                            Command="{Binding ExecuteSearchCommand}"
                            Background="{StaticResource AccentBrush}" Foreground="White"
                            BorderThickness="0" FontSize="14"/>

                    <Button Grid.Column="2" Content="Add Folder" 
                            Margin="8,0,0,0" Padding="16,8"
                            Command="{Binding AddFolderCommand}"
                            Background="{StaticResource CardBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" FontSize="14"/>
                </Grid>
            </Border>

            <!-- Content Area -->
            <ContentControl Content="{Binding CurrentView}" Margin="16"/>

            <!-- Indexing Status Bar -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource SecondaryBrush}" 
                    Padding="12,8" Visibility="{Binding IsIndexing, Converter={StaticResource BoolToVisConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding IndexingStatusText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                        <ProgressBar Value="{Binding IndexingProgress}" Maximum="100" Height="4" 
                                     Margin="0,4,0,0" Background="{StaticResource BorderBrush}"
                                     Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding IndexingSpeed}" 
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
            </Border>
        </DockPanel>
    </Grid>
</Window>
