<UserControl x:Class="PhotoAI.App.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PhotoAI.App.ViewModels">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:GpsClusterViewModel}">
            <Border Background="{StaticResource CardBrush}" 
                    CornerRadius="6" Margin="4"
                    Width="280" Height="180"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Map cluster preview -->
                    <Border Grid.Row="0" ClipToBounds="True" CornerRadius="6,6,0,0"
                            Background="#1E3A5F">
                        <Grid>
                            <TextBlock Text="{Binding Count, StringFormat='📍 {0} photos'}" 
                                       Foreground="White" FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ItemsControl ItemsSource="{Binding Items}" MaxHeight="100">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="40" Height="40" Margin="2" CornerRadius="4" ClipToBounds="True">
                                            <Image Source="{Binding ThumbnailPath}" 
                                                   Stretch="UniformToFill"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="#CC2D2D30" Padding="8,6">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold">
                                <Run Text="Lat: "/>
                                <Run Text="{Binding CenterLat, StringFormat='F4'}"/>
                                <Run Text=" Lng: "/>
                                <Run Text="{Binding CenterLng, StringFormat='F4'}"/>
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0">
                                <Run Text="Bounds: "/>
                                <Run Text="{Binding Bounds.MinLat, StringFormat='F4'}"/>
                                <Run Text=" to "/>
                                <Run Text="{Binding Bounds.MaxLat, StringFormat='F4'}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SecondaryBrush}" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Map View" FontSize="20" FontWeight="Bold" 
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding StatusMessage}" 
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" 
                           Margin="16,0,0,0" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="➖" Command="{Binding ZoomOutCommand}" Width="36" Height="32"
                            Background="{StaticResource CardBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            ToolTip="Zoom Out"/>
                    <Button Content="➕" Command="{Binding ZoomInCommand}" Width="36" Height="32"
                            Background="{StaticResource CardBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            ToolTip="Zoom In" Margin="4,0,0,0"/>
                    <TextBlock Text="{Binding ZoomLevel, StringFormat='Zoom: {0}'}" 
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBlock Text="{Binding TotalPhotos, StringFormat='| {0} photos'}" 
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Map Grid -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Clusters}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <!-- Loading/Empty State -->
        <TextBlock DockPanel.Dock="Bottom"
                   Text="No photos with GPS data found. Import photos with location data to see them on the map."
                   Foreground="{StaticResource TextSecondaryBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="16" Margin="20"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Invert}"/>
    </DockPanel>
</UserControl>