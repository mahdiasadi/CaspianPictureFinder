<UserControl x:Class="PhotoAI.App.Views.PeopleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PhotoAI.App.ViewModels">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:PersonViewModel}">
            <Border Background="{StaticResource CardBrush}" 
                    CornerRadius="8" Margin="8"
                    Width="160" Padding="12"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <!-- Face Circle -->
                    <Border Width="80" Height="80" CornerRadius="40" 
                            Background="{StaticResource BorderBrush}" 
                            ClipToBounds="True" HorizontalAlignment="Center">
                        <Image Source="{Binding RepresentativeFacePath}" 
                               Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="{Binding Name}" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,8,0,0"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                               HorizontalAlignment="Center">
                        <Run Text="{Binding PhotoCount, Mode=OneWay}"/>
                        <Run Text=" photos"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="People" FontSize="24" FontWeight="Bold" 
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding StatusMessage}" 
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding People}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock DockPanel.Dock="Bottom"
                   Text="No people detected yet. Run face detection to identify people."
                   Foreground="{StaticResource TextSecondaryBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="16"/>
    </DockPanel>
</UserControl>
